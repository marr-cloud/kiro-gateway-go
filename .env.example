# Copia este fichero a `.env` y ajusta los valores.
# Las cuentas de Kiro NO se definen aquí, sino en credentials.json
# (ver credentials.json.example y la sección Configuración del README).

# --- Obligatorio ---
# Contraseña para proteger TU proxy: la clave que usarán los clientes al conectarse.
PROXY_API_KEY="cambia-esto-por-una-cadena-segura"

# --- Fichero de cuentas (opcional) ---
# Ruta al array de cuentas. Por defecto: credentials.json en el directorio de trabajo.
# ACCOUNTS_CONFIG_FILE=C:/Users/tu-usuario/kiro/kiro-gateway/credentials.json

# --- Servidor (opcional) ---
# SERVER_HOST=0.0.0.0
# SERVER_PORT=8000

# --- Región de Kiro (opcional) ---
# KIRO_REGION=us-east-1
# KIRO_API_REGION=us-east-1

# --- Comportamiento (opcional) ---
# WEB_SEARCH_ENABLED=true      # herramienta de búsqueda web vía MCP
# TRUNCATION_RECOVERY=true     # recuperación ante respuestas truncadas
# DEBUG_MODE=off               # off | errors | all (logs a ficheros en debug_logs/)
# LOG_LEVEL=INFO               # verbosidad del log de peticiones en stdout: DEBUG|INFO|WARN|ERROR|OFF

# --- VPN / proxy para redes restringidas (opcional) ---
# VPN_PROXY_URL=http://127.0.0.1:7890      # HTTP
# VPN_PROXY_URL=socks5://127.0.0.1:1080    # SOCKS5
