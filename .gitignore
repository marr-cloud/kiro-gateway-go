# Binarios compilados
/kiro-gateway
/kiro-gateway*.exe
/dist/
/bin/

# Artefactos de release descargados para pruebas (zip/tar + carpeta extraida)
/kiro-gateway_v*

# Credenciales y estado en tiempo de ejecución: nunca se versionan
.env
credentials.json
state.json
debug_logs/

# Lista de modelos opcional por-usuario (no secreta, pero es config local;
# su ausencia = lista estática por defecto). El ejemplo sí se versiona.
models.json

# Entorno del generador de corpus
tools/corpus/.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Cobertura y perfiles de Go
*.out
*.test
coverage.html

# Herramientas locales
.kiro/
.idea/
.vscode/
.DS_Store

# Artefactos de la ejecucion con subagentes (ledger, briefs, informes)
/.superpowers/

# Clon del upstream para generar el corpus
/.upstream/

# Copia temporal de la comprobacion de determinismo
/.corpus-check/
